<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>
  <groupId>com.procureflow</groupId>
  <artifactId>procureflow</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>ProcureFlow</name>
  <modules>
    <module>backend/event-contracts</module>
    <module>backend/app</module>
    <module>backend/notification-worker</module>
  </modules>
  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Same-line security patches for GHSA-q4xh-88c3-wmh7; see D002. -->
    <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
    <!-- Tomcat 11.0.24 has published security fixes in 11.0.25/26; see D002. -->
    <tomcat.version>11.0.27</tomcat.version>
    <springdoc.version>3.1.1</springdoc.version>
    <!-- postgres:18.6-bookworm; Testcontainers parses digest-only references correctly. -->
    <postgres.image>postgres@sha256:afc7e2d441324c0388fa80c3d24f733b4194a4eb7f47dd8ee2b08eb1a24a647c</postgres.image>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>java-21-and-maven</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                  <message>Run Maven with JDK 21. Set JAVA_HOME before using ./mvnw.</message>
                </requireJavaVersion>
                <requireMavenVersion><version>[3.9.11,4)</version></requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>integration-test</goal><goal>verify</goal></goals>
          </execution>
        </executions>
        <configuration>
          <systemPropertyVariables>
            <postgres.image>${postgres.image}</postgres.image>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
