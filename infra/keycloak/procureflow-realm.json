{
  "realm": "procureflow",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "clients": [{
    "clientId": "procureflow-web",
    "protocol": "openid-connect",
    "publicClient": true,
    "standardFlowEnabled": true,
    "implicitFlowEnabled": false,
    "directAccessGrantsEnabled": false,
    "serviceAccountsEnabled": false,
    "redirectUris": ["${FRONTEND_ORIGIN}/", "${FRONTEND_ALT_ORIGIN}/"],
    "webOrigins": ["${FRONTEND_ORIGIN}", "${FRONTEND_ALT_ORIGIN}"],
    "attributes": {
      "pkce.code.challenge.method": "S256",
      "post.logout.redirect.uris": "${FRONTEND_ORIGIN}/##${FRONTEND_ALT_ORIGIN}/"
    },
    "protocolMappers": [{
      "name": "procureflow-api-audience",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "config": {"included.custom.audience": "procureflow-api", "access.token.claim": "true", "id.token.claim": "false"}
    }]
  }],
