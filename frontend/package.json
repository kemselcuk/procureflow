{
  "name": "procureflow-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": { "node": ">=22.22.3 <23", "npm": ">=10 <11" },
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
